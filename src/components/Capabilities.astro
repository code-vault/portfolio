---
// "What I bring": six items from capabilities.json (title + one line each).
import { getCollection, getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const site = (await getEntry('site', 'site'))!.data;
const head = site.sections.whatIBring;
const items = (await getCollection('capabilities')).sort((a, b) => Number(a.id) - Number(b.id));
// Note: the reveal animation is on the <li>, the hover lift on the inner card, so they never fight.
---
<section id="what-i-bring" aria-labelledby="bring-title" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <SectionHeading id="bring-title" label={head.label} heading={head.heading} />
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map(({ data }, i) => (
      <li data-reveal data-reveal-delay={(i % 3) * 0.08}>
        <article class="card card-lift h-full p-6">
          <h3 class="text-lg font-semibold text-text">{data.title}</h3>
          <p class="mt-2 leading-relaxed">{data.description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>
