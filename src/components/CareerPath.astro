---
// The 4-step "path" strip at the top of the Experience page (site.json: path).
// A thin line with a small violet dot above each step, the year in bold and the label in grey.
interface Props { label: string; steps: { year: string; label: string }[] }
const { label, steps } = Astro.props;
---
<section aria-labelledby="path-title" class="mx-auto max-w-6xl px-6 pb-16 sm:pb-24">
  <h2 id="path-title" class="label mb-8">{label}</h2>
  <ol class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
    {steps.map((step, i) => (
      <li data-reveal data-reveal-delay={i * 0.08} class="relative border-t border-border-strong pt-6">
        <span class="absolute -top-[5px] left-0 h-2.5 w-2.5 rounded-full bg-violet" aria-hidden="true"></span>
        <p class="text-2xl font-bold tracking-tight text-text sm:text-3xl">{step.year}</p>
        <p class="mt-1 leading-snug">{step.label}</p>
      </li>
    ))}
  </ol>
</section>
