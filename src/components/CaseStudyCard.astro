---
// One case study card, two columns on desktop.
//   Left:  number, title, "company · period", PROBLEM, WHAT I DID, tags, optional link.
//   Right: a light-grey panel with IMPACT (3 big violet numbers + captions) and ARCHITECTURE
//          (the diagram steps as monospace chips joined by ›).
// Content comes from a file in src/content/projects/. Stacks to one column on mobile.
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

// `level` is the heading level of the card title: h3 under a section heading (Home), h2 on the Projects page.
interface Props { project: CollectionEntry<'projects'>; level?: 'h2' | 'h3' }
const { project, level: Title = 'h3' } = Astro.props;
const { data } = project;
const { company, period, problem, solution, metrics, diagram } = data;

// The schema already guarantees these exist for a case study; this just tells TypeScript.
if (!company || !period || !problem || !solution || !metrics || !diagram) {
  throw new Error(`Case study "${data.title}" is missing company, period, problem, solution, metrics or diagram.`);
}

// In the metrics list below, <dt>/<dd> must be direct children of each group <div>: the caption comes first
// for screen readers, and flex-col-reverse shows the big number on top visually.
const number = String(data.order).padStart(2, '0');
// Show the link without "https://" (e.g. github.com/TestCraftStatusneo)
const linkText = data.link?.replace(/^https?:\/\//, '');
---
<!-- The reveal animation is on this wrapper; the hover lift is on the inner card, so they never fight. -->
<li data-reveal>
  <article class="card card-lift grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <!-- Left column -->
    <div class="flex flex-col">
      <p class="font-mono text-sm font-semibold text-accent">{number}</p>
      <Title class="mt-2 text-2xl font-bold tracking-tight text-text sm:text-3xl" style="letter-spacing: -0.02em;">{data.title}</Title>
      <p class="mt-1 text-muted">{company} · {period}</p>

      <div class="mt-6 space-y-5">
        <div>
          <p class="label">Problem</p>
          <p class="mt-1.5 leading-relaxed">{problem}</p>
        </div>
        <div>
          <p class="label">What I did</p>
          <p class="mt-1.5 leading-relaxed">{solution}</p>
        </div>
      </div>

      <div class="mt-auto space-y-4 pt-6">
        <TagList tags={data.tags} />
        {data.link && (
          <a href={data.link} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 font-semibold text-text hover:text-accent">
            {linkText} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
          </a>
        )}
      </div>
    </div>

    <!-- Right column: light-grey panel -->
    <div class="flex flex-col gap-8 rounded-2xl bg-panel p-6 sm:p-7">
      <div>
        <p class="label">Impact</p>
        <dl class="mt-4 divide-y divide-border-strong/60">
          {metrics.map((m) => (
            <div class="flex flex-col-reverse gap-1 py-4 first:pt-0 last:pb-0">
              <dt class="text-sm leading-snug text-muted">{m.label}</dt>
              <dd class="text-3xl font-bold leading-none tracking-tight text-violet sm:text-4xl" style="letter-spacing: -0.02em;">{m.value}</dd>
            </div>
          ))}
        </dl>
        {data.also && (
          <p class="mt-4 text-sm leading-relaxed text-muted"><span class="font-semibold text-text">Also:</span> {data.also}</p>
        )}
      </div>

      <div>
        <p class="label">Architecture</p>
        <ol class="arch mt-3 flex flex-wrap items-center gap-y-2" aria-label="Architecture steps">
          {diagram.map((step) => (
            <li class="arch-step"><span class="chip !bg-surface">{step}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </article>
</li>

<style>
  /* ">" between architecture steps (empty alt text so screen readers skip it) */
  .arch-step:not(:last-child)::after {
    content: '›' / '';
    color: #a3a3a3;
    padding: 0 0.5rem;
  }
</style>
