---
// Contact: label, heading, text, the email (shown as text AND as a mailto link), LinkedIn, GitHub and resume.
// Everything comes from site.json.
import { getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const site = (await getEntry('site', 'site'))!.data;
const contact = site.sections.contact;
---
<section id="contact" aria-labelledby="contact-title" class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <SectionHeading id="contact-title" label={contact.label} heading={contact.heading} />
  <div data-reveal class="card p-6 sm:p-10">
    <p class="max-w-2xl text-xl leading-relaxed text-muted sm:text-2xl sm:leading-relaxed">{contact.text}</p>

    <p class="mt-8">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex min-h-11 items-center break-all text-2xl font-bold tracking-tight text-text underline decoration-violet decoration-2 underline-offset-8 hover:text-accent sm:text-3xl"
      >{site.email}</a>
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
      <a href={site.resumePath} download aria-label="Download resume (PDF)" class="btn btn-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" />
        </svg>
        Resume
      </a>
    </div>
  </div>
</section>
