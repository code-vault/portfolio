---
// Contact: intro line, email (shown as text AND as a mailto link), LinkedIn, GitHub, resume.
// Everything comes from site.json.
import { getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const site = (await getEntry('site', 'site'))!.data;

const base = 'inline-flex items-center rounded-lg px-5 py-3 font-semibold transition-colors';
const primary = `${base} bg-accent text-bg hover:brightness-110`;
const secondary = `${base} border border-border text-text hover:border-accent hover:text-accent`;
---
<section id="contact" aria-labelledby="contact-title" class="mx-auto max-w-5xl px-6 py-20">
  <SectionHeading id="contact-title" title="Contact" />
  <div data-reveal class="rounded-2xl border border-border bg-surface p-6 sm:p-10">
    <p class="text-xl font-medium sm:text-2xl">{site.sections.contact.text}</p>
    <p class="mt-4 text-muted">
      Email:{' '}
      <a href={`mailto:${site.email}`} class="font-semibold text-accent underline-offset-4 hover:underline">{site.email}</a>
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${site.email}`} class={primary}>Email me</a>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class={secondary}>LinkedIn</a>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer" class={secondary}>GitHub</a>
      <a href={site.resumePath} download class={secondary}>Download resume</a>
    </div>
  </div>
</section>
