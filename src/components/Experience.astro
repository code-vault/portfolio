---
// Vertical timeline, newest first. One file per role in src/content/experience/.
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import TagList from './TagList.astro';

// "MM/YYYY" -> a sortable number (YYYYMM). "Present" sorts as newest.
function sortKey(date: string): number {
  if (date === 'Present') return Infinity;
  const [month, year] = date.split('/');
  return Number(year) * 100 + Number(month);
}

// Newest first: by start date, then by end date if two roles start the same month.
const roles = (await getCollection('experience')).sort(
  (a, b) => sortKey(b.data.start) - sortKey(a.data.start) || sortKey(b.data.end) - sortKey(a.data.end),
);
---
<section id="experience" aria-labelledby="experience-title" class="mx-auto max-w-5xl px-6 py-20">
  <SectionHeading id="experience-title" title="Experience" />
  <!-- The vertical line is the left border of the list; each dot sits on top of it -->
  <ol class="ml-2 border-l border-border">
    {roles.map(({ data }) => (
      <li data-reveal class="relative pb-12 pl-8 last:pb-0">
        <span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full border-2 border-accent bg-bg" aria-hidden="true"></span>
        <p class="text-sm text-muted">
          {data.start} – {data.end}{data.location && <> · {data.location}</>}
        </p>
        <h3 class="mt-1 text-xl font-semibold">{data.company}</h3>
        <p class="font-medium text-accent">{data.role}</p>
        <ul class="mt-4 space-y-2 text-muted">
          {data.highlights.map((h) => (
            <li class="flex gap-2 leading-relaxed"><span class="text-accent" aria-hidden="true">▸</span><span>{h}</span></li>
          ))}
        </ul>
        <div class="mt-4"><TagList tags={data.tags} /></div>
      </li>
    ))}
  </ol>
</section>
