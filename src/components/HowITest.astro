---
// "HOW I TEST" card: four stacked rows (layer + one proof line, all with equal visual weight)
// and a monospace footer line. All text comes from site.json (howITest). No looping animation:
// each row only gets a subtle background on hover.
interface Row { layer: string; line: string }
interface Props { title: string; rows: Row[]; footer: string }
const { title, rows, footer } = Astro.props;

// Turn "✓ ui  ✓ mobile" into pieces so each ✓ can be shown in the accent colour.
const footerParts = footer.split(/(✓)/);
---
<div class="card p-3 sm:p-4">
  <h2 class="label px-3 pb-2 pt-3 !text-muted">{title}</h2>

  <ul>
    {rows.map((row) => (
      <li class="how-row grid gap-1 rounded-xl px-3 py-4 sm:grid-cols-[7.5rem_1fr] sm:items-baseline sm:gap-4">
        <span class="whitespace-nowrap font-semibold text-text">{row.layer}</span>
        <span class="leading-snug text-muted">{row.line}</span>
      </li>
    ))}
  </ul>

  <!-- Monospace footer line. white-space: pre keeps the double spaces between items. -->
  <p class="mx-3 mt-2 border-t border-border pb-2 pt-4 font-mono text-xs text-muted" style="white-space: pre-wrap;">
    {footerParts.map((part) => (part === '✓' ? <span class="text-accent">✓</span> : part))}
  </p>
</div>

<style>
  /* Subtle hover state per row (no motion, just a background) */
  .how-row { transition: background-color 0.15s; }
  .how-row:hover { background: var(--color-panel); }

</style>
