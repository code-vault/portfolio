---
// Top navigation (multi-page site).
//   Desktop (>=768px): monogram + name on the left, 3 page links in the centre, "Get in touch" pill on the right.
//   Mobile  (<768px):  monogram + name and a menu button; the button opens a full-screen overlay with
//                      large stacked links and the same pill.
// Both menus are rendered from the same `links` list, so they can never drift apart.
// The current page gets aria-current="page" (styled below). Menu behaviour lives in src/scripts/mobileMenu.ts.
interface Props { name: string }
const { name } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
];

// "/projects/" and "/projects" are the same page.
const clean = (path: string) => path.replace(/\/$/, '') || '/';
const current = clean(Astro.url.pathname);
const isCurrent = (href: string) => clean(href) === current;
---
<header class="site-header sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur" data-site-header>
  <nav aria-label="Main" class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3 md:grid md:grid-cols-[1fr_auto_1fr]">
    <!-- Brand: "DO" monogram + name -->
    <a href="/" data-brand class="inline-flex min-h-11 items-center gap-3 font-semibold text-text md:justify-self-start">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-text text-xs font-bold tracking-wide text-white" aria-hidden="true">DO</span>
      <span>{name}</span>
    </a>

    <!-- Desktop links (centre) -->
    <ul class="hidden items-center gap-1 md:flex" data-nav-links>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="nav-link block rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-text"
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <!-- Desktop call to action (right) -->
    <a href="/#contact" class="btn btn-primary hidden md:inline-flex md:justify-self-end">Get in touch</a>

    <!-- Mobile menu button (disclosure pattern): its name stays "Menu", aria-expanded says open/closed -->
    <button
      type="button"
      class="menu-button -mr-2 inline-flex h-11 w-11 items-center justify-center rounded-lg text-text md:hidden"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>
</header>

<!-- Mobile overlay. It sits OUTSIDE the header on purpose: the header's blur effect would otherwise
     trap a fixed-position child inside the header's box. The header stays above it (z-50 vs z-40),
     so the ✕ button remains clickable. -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 overflow-y-auto overscroll-contain bg-bg px-6 pb-10 pt-24 md:hidden" hidden data-mobile-menu>
  <nav aria-label="Mobile">
    <ul class="flex flex-col" data-nav-links>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="nav-link block min-h-11 border-b border-border py-5 text-4xl font-bold tracking-tight text-text"
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <a href="/#contact" class="btn btn-primary mt-8 w-full">Get in touch</a>
  </nav>
</div>

<style>
  /* Current page: dark violet (passes contrast on the light background) */
  .nav-link[aria-current='page'] { color: var(--color-accent); }

  /* ☰ shows when closed, ✕ when open */
  .menu-button .icon-close { display: none; }
  .menu-button[aria-expanded='true'] .icon-open { display: none; }
  .menu-button[aria-expanded='true'] .icon-close { display: block; }

  /* While the menu is open the bar becomes solid, so nothing shows through it. */
  .site-header[data-menu-open] { background: var(--color-bg); }

  /* Short fade/slide-in when the menu opens (skipped entirely for reduced motion) */
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) { animation: menu-in 0.2s ease-out; }
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  import { initMobileMenu } from '../scripts/mobileMenu';
  initMobileMenu();
</script>
