---
// Sticky top nav. `links` must match the section ids on the page.
// The active-section highlight is handled by src/scripts/activeNav.ts.
interface Props { name: string }
const { name } = Astro.props;

const links = [
  { href: '#work', label: 'Work' },
  { href: '#what-i-do', label: 'What I do' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur">
  <nav aria-label="Main" class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-3">
    <a href="#top" class="shrink-0 font-semibold text-text">{name}</a>
    <!-- On narrow screens the link list scrolls sideways inside the nav (the page itself never does). -->
    <ul class="flex gap-1 overflow-x-auto" data-nav-links>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="nav-link block whitespace-nowrap rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-text"
          >{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Set by activeNav.ts on the link of the section currently in view. */
  .nav-link[aria-current='location'] { color: var(--color-accent); }
</style>

<script>
  import { initActiveNav } from '../scripts/activeNav';
  initActiveNav();
</script>
