---
// Animated pipeline: a pulse travels along a line and each step lights up as it passes.
// Steps come from site.json ("pipeline"). Any number of steps (2+) works.
// Pure CSS animation, so it needs no JavaScript and is switched off for prefers-reduced-motion.
interface Props { steps: string[] }
const { steps } = Astro.props;
---
<ol class="pipeline" style={`--n: ${steps.length}`} aria-label="Quality pipeline">
  <!-- Decorative line + travelling pulse (hidden from screen readers) -->
  <li class="pipeline-track" aria-hidden="true"><span class="pipeline-pulse"></span></li>
  {steps.map((step, i) => (
    <li class="pipeline-step" style={`--i: ${i}`}>
      <span class="pipeline-dot" aria-hidden="true"></span>
      <span class="pipeline-label">{step}</span>
    </li>
  ))}
</ol>

<style>
  /* One cycle = 6s: the pulse crosses the line in the first 4.5s, then rests. */
  .pipeline {
    --cycle: 6s;
    --travel: 4.5s;
    position: relative;
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
    /* Mobile first: vertical list, one fixed-height row per step */
    grid-template-rows: repeat(var(--n), 4rem);
  }
  .pipeline-step {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }
  .pipeline-dot {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: 9999px;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    animation: node-glow var(--cycle) linear infinite;
    /* Light up when the pulse reaches this step */
    animation-delay: calc(var(--i) * var(--travel) / (var(--n) - 1));
  }
  .pipeline-label { color: var(--color-text); font-weight: 500; }

  /* The line runs from the centre of the first dot to the centre of the last */
  .pipeline-track {
    position: absolute;
    background: var(--color-border);
    left: 0.75rem; width: 2px;
    top: 2rem; bottom: 2rem;
  }
  .pipeline-pulse {
    position: absolute;
    left: 50%; top: 0;
    width: 0.75rem; height: 0.75rem;
    margin: -0.375rem 0 0 -0.375rem;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 14px 3px color-mix(in srgb, var(--color-accent) 70%, transparent);
    animation: pulse-down var(--cycle) linear infinite;
  }

  /* Wider screens: horizontal row, dot above label */
  @media (min-width: 768px) {
    .pipeline {
      grid-template-rows: none;
      grid-template-columns: repeat(var(--n), 1fr);
    }
    .pipeline-step { flex-direction: column; gap: 0.75rem; text-align: center; align-items: center; justify-content: flex-start; }
    .pipeline-label { font-size: 0.875rem; line-height: 1.3; padding: 0 0.5rem; }
    .pipeline-track {
      /* inset by half a column so the line starts/ends at the first/last dot centres */
      left: calc(50% / var(--n)); right: calc(50% / var(--n));
      width: auto; height: 2px;
      top: 0.75rem; bottom: auto;
    }
    .pipeline-pulse { left: 0; top: 50%; margin: -0.375rem 0 0 -0.375rem; animation-name: pulse-across; }
  }

  @keyframes pulse-down {
    0% { top: 0; opacity: 1; }
    75% { top: 100%; opacity: 1; }   /* 75% of 6s = 4.5s */
    76%, 100% { top: 100%; opacity: 0; }
  }
  @keyframes pulse-across {
    0% { left: 0; opacity: 1; }
    75% { left: 100%; opacity: 1; }
    76%, 100% { left: 100%; opacity: 0; }
  }
  @keyframes node-glow {
    0% { border-color: var(--color-accent); box-shadow: 0 0 12px var(--color-accent); background: var(--color-accent); }
    10%, 100% { border-color: var(--color-border); box-shadow: none; background: var(--color-bg); }
  }

  /* Respect the visitor's reduced-motion setting: static pipeline, no pulse */
  @media (prefers-reduced-motion: reduce) {
    .pipeline-pulse { display: none; }
    .pipeline-dot { animation: none; border-color: var(--color-accent); }
  }
</style>
