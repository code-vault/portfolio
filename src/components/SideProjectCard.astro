---
// Smaller card for side projects (projects with `side: true`).
// `label` is the small violet label above the title (from site.json sections.projects.sideLabel).
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props { project: CollectionEntry<'projects'>; label: string }
const { project, label } = Astro.props;
const { data } = project;
const linkText = data.link?.replace(/^https?:\/\//, '');
---
<div data-reveal>
  <article class="card card-lift flex flex-col gap-4 p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
    <div class="max-w-2xl">
      <p class="label">{label}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-text" style="letter-spacing: -0.02em;">{data.title}</h2>
      <p class="mt-2 leading-relaxed">{data.description}</p>
      <div class="mt-4"><TagList tags={data.tags} /></div>
    </div>
    {data.link && (
      <a href={data.link} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 shrink-0 items-center gap-1 font-semibold text-text hover:text-accent">
        {linkText} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
      </a>
    )}
  </article>
</div>
