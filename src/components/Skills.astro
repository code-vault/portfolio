---
// Skills as grouped tag clouds, from skills.json.
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import TagList from './TagList.astro';

const groups = (await getCollection('skills')).sort((a, b) => Number(a.id) - Number(b.id));
---
<section id="skills" aria-labelledby="skills-title" class="mx-auto max-w-5xl px-6 py-20">
  <SectionHeading id="skills-title" title="Skills" />
  <div class="grid gap-6 md:grid-cols-2">
    {groups.map(({ data }, i) => (
      <div data-reveal data-reveal-delay={(i % 2) * 0.08}>
        <section class="h-full rounded-2xl border border-border bg-surface p-6" aria-labelledby={`skills-${i}`}>
          <h3 id={`skills-${i}`} class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">{data.group}</h3>
          <TagList tags={data.items} />
        </section>
      </div>
    ))}
  </div>
</section>
