---
// Stats strip. Values and labels come from stats.json.
// Screen readers get the final value in a visually hidden span; the animated text is aria-hidden.
import { getCollection } from 'astro:content';

const stats = (await getCollection('stats')).sort((a, b) => Number(a.id) - Number(b.id));
---
<section id="stats" aria-label="Key numbers" class="mx-auto max-w-5xl px-6 py-12">
  <dl class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    {stats.map(({ data }, i) => (
      <div
        data-reveal
        data-reveal-delay={i * 0.07}
        class="flex flex-col-reverse gap-1 rounded-xl border border-border bg-surface p-5 sm:p-6"
      >
        <!-- dt/dd are direct children of this group <div>. Label comes first for screen readers;
             flex-col-reverse shows the value on top visually. -->
        <dt class="text-sm text-muted">{data.label}</dt>
        <dd class="text-3xl font-bold text-accent sm:text-4xl">
          <span aria-hidden="true" data-count={data.value}>{data.value}</span>
          <span class="sr-only">{data.value}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>
