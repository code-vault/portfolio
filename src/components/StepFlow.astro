---
// A case study's diagram as a simple step-flow: boxes joined by arrows.
// Steps come from the project's `diagram` list. Vertical on mobile, wrapping row on wider screens.
interface Props { steps: string[] }
const { steps } = Astro.props;
---
<ol class="stepflow" aria-label="Flow">
  {steps.map((step) => (
    <li class="stepflow-item">
      <span class="stepflow-box">{step}</span>
    </li>
  ))}
</ol>

<style>
  .stepflow { display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .stepflow-box {
    display: inline-block;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  /* Arrow after every step except the last. The text after "/" is empty alt text, so screen readers skip it. */
  .stepflow-item:not(:last-child)::after {
    content: '↓' / '';
    display: block;
    color: var(--color-accent);
    padding-left: 1rem;
    line-height: 1.4;
  }
  @media (min-width: 768px) {
    .stepflow { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.5rem 0; }
    .stepflow-item { display: flex; align-items: center; }
    .stepflow-item:not(:last-child)::after { content: '→' / ''; padding: 0 0.5rem; }
  }
</style>
