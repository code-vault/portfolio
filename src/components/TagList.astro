---
// Small monospace chips (used by case studies, skills and the experience timeline).
interface Props { tags: string[] }
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label="Technologies">
    {tags.map((tag) => (
      <li class="chip">{tag}</li>
    ))}
  </ul>
)}
