---
// "Case studies" section: full case studies first, then side projects as smaller cards.
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import SideProjectCard from './SideProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = all.filter((p) => !p.data.side);
const sideProjects = all.filter((p) => p.data.side);
---
<section id="work" aria-labelledby="work-title" class="mx-auto max-w-5xl px-6 py-20">
  <SectionHeading id="work-title" title="Case studies" />
  <ul class="space-y-8">
    {caseStudies.map((project) => <CaseStudyCard project={project} />)}
  </ul>

  {sideProjects.length > 0 && (
    <div class="mt-16">
      <h3 class="mb-4 text-lg font-semibold text-muted">Side project</h3>
      <div class="grid gap-6 md:grid-cols-2">
        {sideProjects.map((project) => <SideProjectCard project={project} />)}
      </div>
    </div>
  )}
</section>
