---
// Page shell: <head> (title, SEO, Open Graph, Twitter), skip link, nav, main, footer.
// All text comes from src/content/site.json, nothing is hard-coded here.
import '../styles/global.css';
import { getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';

// Optional props: the 404 page passes `title` and `minimal` (no section nav) and `noindex`.
interface Props { title?: string; minimal?: boolean; noindex?: boolean }
const { title, minimal = false, noindex = false } = Astro.props;

const site = (await getEntry('site', 'site'))!.data;
const pageTitle = title ?? site.metaTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href; // generated in the SEO step
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.metaDescription} />
    <meta name="theme-color" content="#fafafa" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph (link previews on LinkedIn, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={site.metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Marks JS as available so scroll-in start states apply (see global.css) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {minimal ? (
      <header class="border-b border-border">
        <div class="mx-auto flex max-w-6xl items-center px-6 py-4">
          <a href="/" class="font-semibold text-text">{site.name}</a>
        </div>
      </header>
    ) : (
      <Nav name={site.name} />
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-6 py-10 text-sm text-muted">
      © {new Date().getFullYear()} {site.name}
    </footer>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
