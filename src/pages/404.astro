---
// Custom "page not found" page. GitHub Pages serves dist/404.html for unknown URLs.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · Devarshi Ojha" minimal noindex>
  <section class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <p class="label">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-text sm:text-6xl" style="letter-spacing: -0.03em;">Page not found</h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed">That page doesn't exist. It may have moved, or the link may be wrong.</p>
    <a href="/" class="btn btn-primary mt-8">Back to the home page</a>
  </section>
</BaseLayout>
