---
// Custom "page not found" page. GitHub Pages serves dist/404.html for unknown URLs.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · Devarshi Ojha" minimal noindex>
  <section class="mx-auto max-w-5xl px-6 py-32">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">That page doesn't exist. It may have moved, or the link may be wrong.</p>
    <a href="/" class="mt-8 inline-flex items-center rounded-lg bg-accent px-5 py-3 font-semibold text-bg hover:brightness-110">
      Back to the home page
    </a>
  </section>
</BaseLayout>
